# CareSync Nginx Reverse Proxy Configuration Template
# Generated by Ansible — DO NOT EDIT MANUALLY

upstream caresync_backend {
    server 127.0.0.1:{{ app_port }};
    keepalive 32;
}

server {
    listen {{ http_port | default(80) }};
    server_name {{ domain_name | default('localhost') }};

    client_max_body_size 16M;

    access_log /var/log/nginx/caresync_access.log;
    error_log /var/log/nginx/caresync_error.log;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    location / {
        proxy_pass http://caresync_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Operational Liveness / Health Check endpoint
    location /health {
        proxy_pass http://caresync_backend/health;
        proxy_set_header Host $host;
        access_log off;
    }
}
